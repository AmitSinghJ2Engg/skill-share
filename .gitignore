# IDE
/.idea

# Claude Code internal (memory, session state)
/.claude

# Working files — not for commit
/extra files no commit

# Text notes and scratch files
*.txt

# Secrets / credentials (NEVER commit)
.env
.env.local
*.secret
.mcp.json

# Python cache
__pycache__/
*.pyc
*.pyo

# OS
.DS_Store

# Build artifacts — only dist/build/ (marketplace plugins) is tracked
/dist/*
!/dist/build/

# Auto-generated registry (regenerated by generate-registry.py)
/tools/plugin-registry.json
/docs/claude-code-specs/*
!/docs/claude-code-specs/INDEX.md
/context/product-pipeline/daily-discovery

# Scheduled task run logs (DL-020) — keep the directory, ignore the log files
/logs/scheduled/*.log
tasks/product-pipeline/daily-discovery/output/2026-04-04-zone2-report.md
